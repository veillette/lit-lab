# Copy this file to .env and fill in the values.
# Never commit .env to git.
#
# In development (NODE_ENV != production) the access gate is disabled,
# so only PORT matters for editing content locally.

# ---- Moodle (from the External Tool configuration page) ----
MOODLE_URL=https://moodle.example.com
CLIENT_ID=your_client_id_from_moodle
DEPLOYMENT_ID=                 # optional, but recommended

# ---- This app ----
# Public base URL where this app is served (no trailing slash)
TOOL_URL=https://lit-lab-xxxxx.a.run.app
# Random string, minimum 32 characters. Use: openssl rand -hex 32
SESSION_SECRET=replace_with_a_long_random_secret

# ---- Server ----
PORT=3000
NODE_ENV=development   # set to "production" on Cloud Run
