    "dev": "eleventy --serve",
    "preview": "eleventy && wrangler dev",
    "deploy": "eleventy && wrangler deploy"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "wrangler": "^4.146.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
