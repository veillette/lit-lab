{
  "name": "lit-lab",
  "version": "1.0.0",
  "description": "Private Eleventy textbook, accessible only via LTI 1.3 launch from Moodle",
  "main": "server.js",
  "scripts": {
    "build": "eleventy",
    "build:watch": "eleventy --watch",
    "start": "node server.js",
    "dev": "concurrently \"eleventy --watch\" \"nodemon --watch server.js server.js\""
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
